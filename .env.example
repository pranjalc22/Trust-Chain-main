# ============================================================
#  TrustChain Frontend — Environment Variables (.env.example)
# ============================================================
#  Copy this file to .env in the project root:
#    cp .env.example .env
# ============================================================

# Backend REST API base URL (no trailing slash)
VITE_API_URL=http://localhost:3001/api

# Deployed smart-contract addresses (defaults from the Hardhat local deploy script)
VITE_ESCROW_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
VITE_REPUTATION_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# Target chain: 31337 = local Hardhat node (default), 80002 = Polygon Amoy
VITE_CHAIN_ID=31337
