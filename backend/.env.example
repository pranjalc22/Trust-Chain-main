# ============================================================
#  TrustChain Backend — Environment Variables (.env.example)
# ============================================================
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
# ============================================================

# Server Port
PORT=3001

# PostgreSQL Connection String
# Format: postgres://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://postgres:password@localhost:5432/trustchain

# Set to true if you want Sequelize to automatically alter/sync tables on server start
AUTO_SYNC_DB=true

# JWT Secret & Expiry for Wallet Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Blockchain RPC Provider (e.g. Local Hardhat node, Polygon, Sepolia)
RPC_URL=http://127.0.0.1:8545

# Deployed Smart Contract Addresses (output from `npx hardhat run scripts/deploy.js`)
ESCROW_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
REPUTATION_CONTRACT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# Optional: restrict the off-chain dispute-resolution endpoint to a single arbitrator.
# Leave unset for demo mode (any authenticated wallet may record a verdict on-chain first).
# ARBITRATOR_WALLET=0x3c44cdddb6a900fa2b585dd299e03d12fa4293bc
